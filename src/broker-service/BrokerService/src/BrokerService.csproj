<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EasyTrade.BrokerService</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <AnalysisLevel>latest-Minimum</AnalysisLevel>
    <Version>1.0.0-easytrade</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="OpenFeature" Version="2.7.0" />
    <PackageReference Include="HostInitActions" Version="1.3.1" />
    <PackageReference Include="Grpc.Tools" Version="2.64.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Grpc.AspNetCore" Version="2.64.0" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\..\..\proto\common.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\..\proto\balance_service.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\..\proto\instrument_service.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\..\proto\product_service.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\..\proto\trade_service.proto" GrpcServices="Client" />
  </ItemGroup>
</Project>
