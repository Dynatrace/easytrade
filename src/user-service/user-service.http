@baseUrl = http://localhost:8089
# Account ids are generated at startup: paste the id returned by "Login" (or from presets) here.
@accountId = 00000000-0000-0000-0000-000000000000

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "james_norton",
  "password": "pass_james_123"
}

### Signup (usernames are unique: change "username" and "email" when re-running, otherwise 409)
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "packageId": "a0000000-0000-4000-8000-000000000001",
  "firstName": "Jane",
  "lastName": "Doe",
  "username": "jane_doe",
  "email": "jane.doe@example.com",
  "password": "securepassword",
  "origin": "WEB",
  "address": "123 Main St, Springfield"
}

### Get account by ID
GET {{baseUrl}}/api/accounts/{{accountId}}

### Get preset accounts
GET {{baseUrl}}/api/accounts/presets

### Get preset accounts with limit
GET {{baseUrl}}/api/accounts/presets?limit=5

### Get version
GET {{baseUrl}}/api/version
